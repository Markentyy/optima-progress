{
  "manifest_version": 3,
  "name": "Optima Progress (local)",
  "version": "0.4.0",
  "description": "Local-only counters for lectures and practices, school mean and college total with ECTS. Everything is computed in the browser, nothing is sent anywhere.",
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["src/stats.css"],
      "matches": ["https://b.optima-osvita.org/*"]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Optima Progress (local)"
  },
  "content_scripts": [
    {
      "matches": ["https://b.optima-osvita.org/my", "https://b.optima-osvita.org/my/", "https://b.optima-osvita.org/my/*"],
      "js": ["src/parsers.js", "src/i18n.js", "src/statsview.js", "src/content_my.js", "src/content_panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://b.optima-osvita.org/grade/report/user/index.php*"],
      "js": ["src/parsers.js", "src/content_grade.js"],
      "run_at": "document_idle"
    }
  ]
}
